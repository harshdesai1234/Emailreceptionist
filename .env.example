# ==============================================================================
# Email Receptionist — Environment Variables
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-email-receptionist-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Provider API Keys (at least one is required for AI drafting)
# Priority order: Claude -> OpenAI -> Gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional AI Provider selection ('auto', 'claude', 'openai', or 'gemini')
EMAIL_RECEPTIONIST_AI_PROVIDER=auto

# Optional model overrides
EMAIL_RECEPTIONIST_MODEL=claude-sonnet-4-6
EMAIL_RECEPTIONIST_OPENAI_MODEL=gpt-4o
EMAIL_RECEPTIONIST_GEMINI_MODEL=gemini-3.5-flash

# Fernet encryption key for mailbox app passwords and tokens
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_RECEPTIONIST_ENCRYPTION_KEY=

# Mailbox OAuth Credentials (Optional: only needed for 1-click account connection)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=

# Celery Configuration (Optional: default falls back to synchronous local mode)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
